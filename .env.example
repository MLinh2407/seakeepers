AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here
AWS_REGION=us-east-1

# --- Flask ---
# Used to sign session cookies (login state) — set to any long
# random string for local dev, and to something equally random
# (but different) on Elastic Beanstalk.
FLASK_SECRET_KEY=change_this_to_a_random_string

# --- Third-party APIs ---
OPENWEATHERMAP_API_KEY=your_openweathermap_key_here
# Nominatim (OpenStreetMap) requires no API key, but does require
# a descriptive User-Agent header on every request per their usage
# policy — set this to something identifying your app, not a browser UA.
NOMINATIM_USER_AGENT=SeaKeepers-RMIT-Assignment3

# --- DynamoDB table names ---
# Keeping these as variables (not hardcoded in app.py) makes it easy
# to point at different tables for local testing vs. deployed EB.
DYNAMODB_USERS_TABLE=Users
DYNAMODB_REPORTS_TABLE=DebrisReports
DYNAMODB_CAMPAIGNS_TABLE=Campaigns
DYNAMODB_RSVPS_TABLE=RSVPs

# --- S3 bucket names ---
S3_PHOTOS_BUCKET=seakeepers-debris-photos
S3_DATA_BUCKET=seakeepers-noaa-data

# ElastiCache (Redis) & Athena / Glue
REDIS_HOST=seakeepers-cache.2bo47z.ng.0001.use1.cache.amazonaws.com
REDIS_PORT=6379
ATHENA_DATABASE=seakeepers_catalog
ATHENA_TABLE=seakeepers_noaa_data_s4146535
ATHENA_OUTPUT_LOCATION=s3://seakeepers-athena-results-s4146535/